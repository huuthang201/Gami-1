<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">
    <changeSet id="004" author="you">
        <createTable tableName="check_in">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_ci_user" referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="check_in_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="awarded_points" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addUniqueConstraint tableName="check_in" columnNames="user_id,check_in_date" constraintName="uk_ci_user_date"/>
        <createIndex tableName="check_in" indexName="idx_ci_user_date">
            <column name="user_id"/>
            <column name="check_in_date"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>