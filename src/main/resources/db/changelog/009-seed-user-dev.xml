<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="009" author="you" context="dev">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM users WHERE username = 'test_user'
            </sqlCheck>
        </preConditions>

        <insert tableName="users">
            <column name="username"      value="test_user"/>
            <column name="email"         value="test_user@test.com"/>
            <column name="total_points"  valueNumeric="0"/>
        </insert>

        <rollback>
            <delete tableName="users">
                <where>username='test_user'</where>
            </delete>
        </rollback>
    </changeSet>
</databaseChangeLog>